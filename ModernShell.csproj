<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModernShell</RootNamespace>
    <AssemblyName>ModernShell</AssemblyName>
    <StartupObject>ModernShell.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\ModernShell.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <!-- Linux/macOS からのクロスビルドも可能にする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinForms 用の高 DPI 警告。DPI は app.manifest (PerMonitorV2) で WPF と共通に設定している -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- 常駐アプリなので、速さより使用メモリの少なさを優先する GC 設定 -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- .NET・WPF の翻訳データは日本語だけ同梱する（英語は本体に入っている）。ほかの言語のフォルダーを作らない -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- 断片化した大きなオブジェクト領域も詰めて、空いたメモリを OS に返しやすくする (0-9) -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <!-- 通知領域（トレイ）とタスク一覧。RetroBar / Cairo Shell と同じ、explorer に注入しない方式のライブラリ (Apache-2.0) -->
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="verify/**" />
  </ItemGroup>
</Project>
